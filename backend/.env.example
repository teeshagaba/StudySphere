# Defaults run with zero infrastructure (SQLite + in-memory cache). For production use:
# DATABASE_URL=postgresql+psycopg://studyos:studyos@localhost:5432/studyos
# REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./studyos.db
REDIS_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=["http://localhost:3000"]

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Or any OpenAI-compatible API (used when Azure is not set). Without either, the mentor runs in offline mode.
# Groq (free tier):  AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# Gemini:            AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   AI_MODEL=gemini-2.0-flash
# Ollama (local):    AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=llama3.1   (AI_API_KEY can be anything)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Self-hosted Judge0 (X-Auth-Token) or RapidAPI (https://judge0-ce.p.rapidapi.com)
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=

# Optional: clist.by API key unlocks AtCoder, HackerRank, HackerEarth, TopCoder, Kaggle, GFG, etc.
CLIST_USERNAME=
CLIST_API_KEY=
